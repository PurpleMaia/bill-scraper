{
  "name": "hawaii-legislature-scraper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cron:scrape": "node server/cron-scrape.js",
    "scrape:recover": "node scrape.js",
    "scrape:dry-run": "node scrape.js --dry-run",
    "start": "node server/index.js",
    "seed:legislators": "node scripts/scraping/scrape-legislators.js",
    "seed:committees": "node scripts/scraping/scrape-committees.js",
    "seed:versions": "node scripts/scraping/seed-versions-reports.js",
    "kysely-codegen": "kysely-codegen --dialect postgres --env-file ./.env --out-file db/generated.d.ts",
    "test": "node --test \"server/**/*.test.js\"",
    "postinstall": "playwright install chromium",
    "sim:seed": "node scripts/sim/seed.js",
    "sim:run": "node scripts/sim/run-day.js",
    "sim:flag": "node scripts/sim/flag.js",
    "sim:reset": "node scripts/sim/reset.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.7",
    "axios": "^1.10.0",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^3.3.1",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "kysely": "^0.28.2",
    "lucide-react": "^0.344.0",
    "openai": "^5.8.1",
    "papaparse": "^5.4.1",
    "pg": "^8.16.2",
    "playwright": "^1.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-query": "^3.39.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/express": "^5.0.3",
    "@types/papaparse": "^5.3.14",
    "@types/pg": "^8.15.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "kysely-codegen": "^0.18.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
